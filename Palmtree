		if character then
			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA("BasePart") or part:IsA("Decal") then
					part.Transparency = 1
				end
			end
			sendMessage(chatId, "Character made invisible locally.")
		end

	elseif command == "/vis" then
		if character then
