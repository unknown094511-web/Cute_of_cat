local function pollTelegram()
	local data = telegramGet("getUpdates", {
		offset = lastUpdateId + 1,
		timeout = 0,
		allowed_updates = "message"
	})

	if not data or not data.ok or not data.result then return end

	for _, update in ipairs(data.result) do
		lastUpdateId = update.update_id
		local message = update.message
		if message and message.text and message.chat then
			local senderId = message.from and message.from.id or 0
			task.spawn(executeCommand, message.text, message.chat.id, senderId)
		end
	end
end

task.spawn(function()
	while running do
		pollTelegram()
		task.wait(0.2)
	end
end)
