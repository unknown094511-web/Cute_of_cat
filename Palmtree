local function getPlayer(query)
	if not query or query == "" then return nil end
	query = query:lower()
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Name:lower():sub(1, #query) == query or player.DisplayName:lower():sub(1, #query) == query then
			return player
		end
	end
	return nil
end

local function telegramGet(method, params)
	local url = API .. method
	if params then
		local query = {}
		for key, value in pairs(params) do
			table.insert(query, HttpService:UrlEncode(key) .. "=" .. HttpService:UrlEncode(tostring(value)))
		end
		url ..= "?" .. table.concat(query, "&")
	end

	local ok, response = pcall(function() return game:HttpGet(url) end)
	if not ok then return nil end

	local decoded, data = pcall(function() return HttpService:JSONDecode(response) end)
	if not decoded then return nil end
	return data
end

local function sendMessage(chatId, text, parseMode)
	local params = { chat_id = chatId, text = text }
	if parseMode then params.parse_mode = parseMode end
	telegramGet("sendMessage", params)
end

local function isAuthorized(userId)
	if #ADMIN_IDS == 0 then return true end
	for _, id in ipairs(ADMIN_IDS) do
		if id == userId then return true end
	end
	return false
end

local function executeCommand(fullText, chatId, userId)
	if not isAuthorized(userId) then
		sendMessage(chatId, "Unauthorized access.")
		return
	end

	local args = string.split(fullText:match("^%s*(.-)%s*$"), " ")
	local command = string.lower(table.remove(args, 1))

	local localPlayer = Players.LocalPlayer
	local character = localPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")

	-- Core Information & Group IDs
	if command == "/bot" then
		sendMessage(chatId, "Roblox bot online and listening! ⚡")

	elseif command == "/chatid" or command == "/telegramgroup" then
		sendMessage(chatId, "📌 *Current Telegram Chat/Group ID:* `" .. tostring(chatId) .. "`\nSender User ID: `" .. tostring(userId) .. "`", "Markdown")

	elseif command == "/groupid" or command == "/group" then
		local ownerType = game.CreatorType.Name
		local ownerId = game.CreatorId
		local msg = "🏰 *Game Creator Info:*\n" ..
		            "Type: " .. ownerType .. "\n" ..
		            "ID: `" .. tostring(ownerId) .. "`\n"
		if game.CreatorType == Enum.CreatorType.Group then
			msg ..= "🔗 [View Roblox Group](https://www.roblox.com/groups/" .. tostring(ownerId) .. ")"
		end
		sendMessage(chatId, msg, "Markdown")

	elseif command == "/ingroup" then
		local targetQuery = args[1]
		local groupId = tonumber(args[2])

		if targetQuery and not groupId then
			groupId = tonumber(targetQuery)
			targetQuery = localPlayer.Name
		end

		if not groupId then
			sendMessage(chatId, "Usage: /ingroup [player] <groupId>")
			return
		end

		local targetPlayer = getPlayer(targetQuery) or localPlayer
		local rank = targetPlayer:GetRankInGroup(groupId)
		local role = targetPlayer:GetRoleInGroup(groupId)

		sendMessage(chatId, string.format("👥 *Group Status for %s:*\nGroup ID: %d\nRank: %d\nRole: %s", targetPlayer.Name, groupId, rank, role), "Markdown")

	elseif command == "/jobid" then
		local link = "roblox://experiences/start?placeId=" .. game.PlaceId .. "&gameInstanceId=" .. game.JobId
		local msg = "🆔 *JobId:* `" .. game.JobId .. "`\n" ..
		            "📍 *PlaceId:* `" .. game.PlaceId .. "`\n\n" ..
		            "🔗 [Click to Direct-Join Server](" .. link .. ")"
		sendMessage(chatId, msg, "Markdown")

	elseif command == "/join" then
		local targetJobId = args[1]
		local targetPlaceId = tonumber(args[2]) or game.PlaceId

		if not targetJobId or targetJobId == "" then
			sendMessage(chatId, "Usage: /join <jobId> [placeId]")
			return
		end

		sendMessage(chatId, "Teleporting to JobId: " .. targetJobId)
		TeleportService:TeleportToPlaceInstance(targetPlaceId, targetJobId, localPlayer)

	elseif command == "/serverinfo" then
		local ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
		local uptime = math.floor(workspace.DistributedGameTime)
		local msg = string.format("📊 *Server Info:*\nPlayers: %d/%d\nPing: %d ms\nUptime: %d sec\nPlaceId: %d", 
			#Players:GetPlayers(), Players.MaxPlayers, ping, uptime, game.PlaceId)
		sendMessage(chatId, msg, "Markdown")

	elseif command == "/info" then
		sendMessage(chatId, "Player: " .. localPlayer.Name .. "\nUserId: " .. localPlayer.UserId .. "\nPlaceId: " .. game.PlaceId)

	elseif command == "/players" then
		local names = {}
		for _, player in ipairs(Players:GetPlayers()) do
			table.insert(names, player.Name .. " (@" .. player.DisplayName .. ")")
		end
		sendMessage(chatId, "Players (" .. #names .. "):\n" .. table.concat(names, "\n"))

	elseif command == "/pos" then
		if rootPart then
			local pos = rootPart.Position
			sendMessage(chatId, string.format("Position:\nX: %.2f\nY: %.2f\nZ: %.2f", pos.X, pos.Y, pos.Z))
		else
			sendMessage(chatId, "Character position unavailable.")
		end

	-- Teleportation & Movement Mechanics
	elseif command == "/goto" then
		local target = getPlayer(args[1])
		if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") and rootPart then
			rootPart.CFrame = target.Character.HumanoidRootPart.CFrame
			sendMessage(chatId, "Teleported to " .. target.Name)
		else
			sendMessage(chatId, "Player not found or character invalid.")
		end

	elseif command == "/to" then
		local x, y, z = tonumber(args[1]), tonumber(args[2]), tonumber(args[3])
		if x and y and z and rootPart then
			rootPart.CFrame = CFrame.new(x, y, z)
			sendMessage(chatId, string.format("Teleported to X: %.1f, Y: %.1f, Z: %.1f", x, y, z))
