		end

	elseif command == "/sit" then
		if humanoid then humanoid.Sit = true sendMessage(chatId, "Sitting.") end

	elseif command == "/freeze" then
		if rootPart then rootPart.Anchored = true sendMessage(chatId, "Frozen ❄️") end

	elseif command == "/unfreeze" then
